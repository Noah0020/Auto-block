		local oldNamecall
		local function namecallHook(self, ...)
			local method = getnamecallmethod and getnamecallmethod()
			if method == "FireServer" or method == "InvokeServer" then
				local args = {...}
				for i = 1, #tbl5 do
					local cb = tbl5[i]
					if cb then
						local ok, res = pcall(cb, self, method, args)
						if ok then
							if res == false then
								return
							end
							if type(res) == "table" then
								args = res
							end
						end
					end
				end
				return oldNamecall(self, table.unpack(args))
			end
			return oldNamecall(self, ...)
		end
		local v3 = newcclosure and newcclosure(namecallHook) or namecallHook

		if hookmetamethod then
			oldNamecall = hookmetamethod(game, "__namecall", v3)
		else
			local v4 = getrawmetatable(game)
			setreadonly(v4, false)
			oldNamecall = v4.__namecall
			v4.__namecall = v3
			setreadonly(v4, true)
