			end
			table.clear(conns)
			active = false
		end

		local hb
		hb = RunService.Heartbeat:Connect(function()
			if not AB.Enabled or AB.Mode ~= "New HDT" then
				cleanup()
				if hb then hb:Disconnect() end
				return
			end
			if not model.Parent or not hrp.Parent then
