		Description = "Briefly faces killer when they M1 near you",
		Callback = function(v)
			M1Lock.Enabled = v
			if v and not M1Lock.conn then
				M1Lock.conn = RunService.Heartbeat:Connect(briefLockStep)
			elseif not v and M1Lock.conn then
				M1Lock.conn:Disconnect()
				M1Lock.conn = nil
			end
		end,
	})
	Aimbot:AddSlider({
