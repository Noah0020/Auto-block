	local m1Anims = {
		["rbxassetid://96959123077498"] = true,
		["rbxassetid://72722244508749"] = true,
		["rbxassetid://102228729296384"] = true,
		["rbxassetid://112809109188560"] = true,
		["rbxassetid://136323728355613"] = true,
		["rbxassetid://84116622032112"] = true,
	}

	local function briefLockStep()
		if not M1Lock.Enabled then return end
		local now = os.clock()
		local char = localPlayer.Character
		local our = char and char:FindFirstChild("HumanoidRootPart")
		if not our then return end

		if now < M1Lock.lockUntil and M1Lock.targetRoot and M1Lock.targetRoot.Parent then
			local pos = M1Lock.targetRoot.Position
			local flat = Vector3.new(pos.X, our.Position.Y, pos.Z)
			if (flat - our.Position).Magnitude > 0.1 then
				our.CFrame = CFrame.lookAt(our.Position, flat)
			end
			return
		end

		-- Scan nearby killers for playing M1 anim
		local list = {}
		pcall(function()
			if forsakenFK and forsakenFK.Roster then list = forsakenFK.Roster.killers() or {} end
		end)
		if #list == 0 and killers then
			for _, c in ipairs(killers:GetChildren()) do table.insert(list, c) end
		end
		for _, k in ipairs(list) do
			local hrp = k:FindFirstChild("HumanoidRootPart")
			local hum = k:FindFirstChildOfClass("Humanoid")
			if not hrp or not hum or hum.Health <= 0 then continue end
			if (hrp.Position - our.Position).Magnitude > M1Lock.Range then continue end
			local anim = hum:FindFirstChildOfClass("Animator")
			if not anim then continue end
			for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
				local id = track.Animation and track.Animation.AnimationId
				if id and (m1Anims[id] or tostring(id):find("Slash") or tostring(id):find("Attack") or tostring(id):find("Punch") or tostring(id):find("Stab")) then
					if track.TimePosition / math.max(track.Length, 0.01) < 0.6 then
						M1Lock.targetRoot = hrp
						M1Lock.lockUntil = now + M1Lock.Duration
						return
					end
				end
			end
		end
	end

