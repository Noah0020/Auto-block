	local function antiBaitStep()
		if not AB.AntiBait then return end
		local char = localPlayer.Character
		local ourRoot = char and char:FindFirstChild("HumanoidRootPart")
		if not ourRoot then return end
		local target, dist = getClosestKillerRoot()
