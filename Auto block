	local GA = {
		Enabled = false,
		Method = tbl.AimBotMethod or "Camera Lock",
		Distance = tbl.AimBotDistance or 80,
		Predict = tbl.AimBotPrediction or 0.1,
		Smooth = (tbl.AimBotSmoothness or 35) / 100,
		Part = tbl.AimBotPart or "Head",
		WallCheck = tbl.WallCheck or false,
		SingleTarget = tbl.SingleTargetMode or false,
		TargetType = tbl.AimTargetType or "Auto",
		conn = nil,
		locked = nil,
	}

	local function pickTarget()
		if GA.SingleTarget and GA.locked and GA.locked.Parent then
			local h = GA.locked:FindFirstChildOfClass("Humanoid")
			if h and h.Health > 0 then
				return GA.locked:FindFirstChild(GA.Part) or GA.locked:FindFirstChild("HumanoidRootPart")
			end
			GA.locked = nil
		end
		local role = v4 and v4() or ""
		local list = {}
		local wantKillers = GA.TargetType == "Killers" or (GA.TargetType == "Auto" and role == "Survivors")
		if wantKillers then
			pcall(function() list = forsakenFK.Roster.killers() or {} end)
			if #list == 0 and killers then for _, c in ipairs(killers:GetChildren()) do table.insert(list, c) end end
		else
			pcall(function() list = forsakenFK.Roster.survivors() or {} end)
			if #list == 0 and survivors then for _, c in ipairs(survivors:GetChildren()) do table.insert(list, c) end end
		end
		local cam = currentCamera
		local origin = cam and cam.CFrame.Position or Vector3.zero
		local best, bestD = nil, GA.Distance
		for _, m in ipairs(list) do
			if m == localPlayer.Character then continue end
			local part = m:FindFirstChild(GA.Part) or m:FindFirstChild("HumanoidRootPart")
			local hum = m:FindFirstChildOfClass("Humanoid")
			if part and hum and hum.Health > 0 then
				local d = (part.Position - origin).Magnitude
				if d < bestD then
					if GA.WallCheck and cam then
						local rp = RaycastParams.new()
						rp.FilterType = Enum.RaycastFilterType.Exclude
						rp.FilterDescendantsInstances = { localPlayer.Character }
						local hit = workspace:Raycast(origin, part.Position - origin, rp)
						if hit and not hit.Instance:IsDescendantOf(m) then
							continue
						end
					end
					bestD, best = d, m
				end
			end
		end
		if best then GA.locked = best end
		return best and (best:FindFirstChild(GA.Part) or best:FindFirstChild("HumanoidRootPart"))
	end

	local function loop()
		if not GA.Enabled then return end
		local part = pickTarget()
		if not part then return end
		local vel = part.AssemblyLinearVelocity
		if vel.Magnitude > 120 then vel = Vector3.zero end
		local pos = part.Position + vel * GA.Predict
		local char = localPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local s = math.clamp(GA.Smooth, 0.05, 1)
		if GA.Method:find("HumanoidRoot") and root then
			local flat = Vector3.new(pos.X, root.Position.Y, pos.Z)
			if (flat - root.Position).Magnitude > 0.05 then
				root.CFrame = root.CFrame:Lerp(CFrame.lookAt(root.Position, flat), s)
			end
		end
		if GA.Method:find("Camera") and currentCamera then
			currentCamera.CFrame = currentCamera.CFrame:Lerp(CFrame.lookAt(currentCamera.CFrame.Position, pos), s)
		end
	end

