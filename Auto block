				target.CFrame.RightVector * offsets.right,
				-target.CFrame.RightVector * offsets.left,
			}
		else
			dirs = { target.CFrame.LookVector * offsets.front }
		end

		local pos = target.Position + dirs[offsetIndex]
		offsetIndex = offsetIndex + 1
		if offsetIndex > #dirs then offsetIndex = 1 end

		local dir = (pos - ourRoot.Position).Unit
		local shake = AB.HitboxShake and Vector3.new(
			math.random(-50,50)/50, math.random(-50,50)/50, math.random(-50,50)/50
		) or Vector3.zero
		local speed = AB.HitboxSpeed + (dist or 0) * 10
		ourRoot.AssemblyLinearVelocity = dir * speed + shake
	end

