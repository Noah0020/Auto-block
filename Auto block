	local SkillAim = {
		ChanceShoot = false,
		JaneCrystal = false,
		JaneAxe = false,
		DusekkarPlasma = false,
		GuestPunch = false,
		Pizza = false,
		Method = "HumanoidRoot Lock",
		Smooth = 0.25,
		Predict = 0.15,
		MaxDist = 120,
		conn = nil,
	}

	local function getEnemyRoot()
		local role = v4 and v4() or ""
		local list, folder = {}, nil
		if role == "Survivors" then
			pcall(function() list = forsakenFK.Roster.killers() or {} end)
			if #list == 0 and killers then
				for _, c in ipairs(killers:GetChildren()) do table.insert(list, c) end
			end
		else
			pcall(function() list = forsakenFK.Roster.survivors() or {} end)
			if #list == 0 and survivors then
				for _, c in ipairs(survivors:GetChildren()) do table.insert(list, c) end
			end
		end
		local char = localPlayer.Character
		local our = char and char:FindFirstChild("HumanoidRootPart")
		if not our then return nil end
		local best, bestD = nil, SkillAim.MaxDist
		for _, m in ipairs(list) do
			if m == char then continue end
			local hrp = m:FindFirstChild("HumanoidRootPart")
			local hum = m:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local d = (hrp.Position - our.Position).Magnitude
				if d < bestD then bestD, best = d, hrp end
			end
		end
		return best
	end

	local function aimAt(targetPos)
		local char = localPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root or not targetPos then return end
		local method = SkillAim.Method
		local smooth = SkillAim.Smooth
		if method:find("HumanoidRoot") then
			local flat = Vector3.new(targetPos.X, root.Position.Y, targetPos.Z)
			if (flat - root.Position).Magnitude > 0.05 then
				root.CFrame = root.CFrame:Lerp(CFrame.lookAt(root.Position, flat), smooth)
			end
		end
		if method:find("Camera") and currentCamera then
			currentCamera.CFrame = currentCamera.CFrame:Lerp(
				CFrame.lookAt(currentCamera.CFrame.Position, targetPos), smooth
			)
		end
	end

	local function anySkillOn()
		return SkillAim.ChanceShoot or SkillAim.JaneCrystal or SkillAim.JaneAxe
			or SkillAim.DusekkarPlasma or SkillAim.GuestPunch or SkillAim.Pizza
	end

	local function skillLoop()
		if not anySkillOn() then return end
		local char = localPlayer.Character
		if not char then return end
		local name = char.Name
		local need = false
		if name == "Chance" and SkillAim.ChanceShoot then need = true end
		if name == "JaneDoe" and (SkillAim.JaneCrystal or SkillAim.JaneAxe) then need = true end
		if name == "Dusekkar" and SkillAim.DusekkarPlasma then need = true end
		if name == "Guest1337" and SkillAim.GuestPunch then need = true end
		if name == "c00lkidd" and SkillAim.Pizza then need = true end
		-- also allow when attribute CharacterName is set
		local attr = char:GetAttribute("CharacterName")
		if attr == "Chance" and SkillAim.ChanceShoot then need = true end
		if attr == "JaneDoe" and (SkillAim.JaneCrystal or SkillAim.JaneAxe) then need = true end
		if attr == "Dusekkar" and SkillAim.DusekkarPlasma then need = true end
		if attr == "Guest1337" and SkillAim.GuestPunch then need = true end

		if not need then return end
		local target = getEnemyRoot()
		if not target then return end
		local vel = target.AssemblyLinearVelocity
		if vel.Magnitude > 120 then vel = Vector3.zero end
		local pred = target.Position + vel * SkillAim.Predict
		aimAt(pred)
