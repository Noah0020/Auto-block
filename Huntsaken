local function clearHL(model)
	if highlights[model] then
		pcall(function() highlights[model]:Destroy() end)
		highlights[model] = nil
	end
	if labels[model] then
		pcall(function() labels[model]:Destroy() end)
		labels[model] = nil
	end
end

local function applyHL(model, color, text)
	if not model or not model.Parent then return end
	local h = highlights[model]
	if not h or not h.Parent then
		h = Instance.new("Highlight")
		h.Name = "HS_HL"
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.FillTransparency = 0.65
		h.OutlineTransparency = 0
		h.Parent = model
		highlights[model] = h
	end
	h.FillColor = color
	h.OutlineColor = color
	h.Adornee = model
	if text then
		local bb = labels[model]
		if not bb or not bb.Parent then
			bb = Instance.new("BillboardGui")
			bb.Name = "HS_TAG"
			bb.Size = UDim2.new(0, 120, 0, 24)
			bb.StudsOffset = Vector3.new(0, 3, 0)
			bb.AlwaysOnTop = true
			bb.Parent = model
			local lbl = Instance.new("TextLabel")
			lbl.Size = UDim2.new(1, 0, 1, 0)
			lbl.BackgroundTransparency = 1
			lbl.TextColor3 = color
			lbl.TextStrokeTransparency = 0.4
			lbl.Font = Enum.Font.GothamBold
			lbl.TextSize = 14
			lbl.Parent = bb
			labels[model] = bb
		end
		local lbl = labels[model]:FindFirstChildOfClass("TextLabel")
		if lbl then lbl.Text = text lbl.TextColor3 = color end
		labels[model].Adornee = getRoot(model) or model:FindFirstChildWhichIsA("BasePart")
	end
end

local function scanMapObjects()
	local map = Workspace:FindFirstChild("Map") or (Workspace:FindFirstChild("Ingame") and Workspace.Ingame:FindFirstChild("Map"))
	if not map then
		for _, v in ipairs(Workspace:GetChildren()) do
			if v:FindFirstChild("Generator") or v.Name == "Map" then map = v break end
		end
	end
	return map
end

local function refreshEsp()
	for m in pairs(highlights) do
		if not m.Parent then clearHL(m) end
	end
	if S.KillerEsp then
		for _, k in ipairs(getKillers()) do applyHL(k, S.KillerColor, "KILLER") end
	else
		for _, k in ipairs(getKillers()) do clearHL(k) end
	end
	if S.SurvivorEsp then
		for _, s in ipairs(getSurvivors()) do
			if s ~= LocalPlayer.Character then applyHL(s, S.SurvivorColor, "SURV") end
		end
	else
		for _, s in ipairs(getSurvivors()) do clearHL(s) end
	end
	-- Map objects
	local map = scanMapObjects()
	if not map then return end
	for _, child in ipairs(map:GetDescendants()) do
		local n = child.Name:lower()
		if S.GenEsp and (n == "generator" or n == "fakegenerator") and child:IsA("Model") then
			applyHL(child, S.GenColor, "GEN")
		elseif S.PizzaEsp and (n:find("pizza") or n:find("delivery")) and child:IsA("Model") then
			applyHL(child, S.PizzaColor, "PIZZA")
		elseif S.TaphEsp and (n:find("trap") or n:find("taph") or n:find("subspace")) and (child:IsA("Model") or child:IsA("BasePart")) then
			applyHL(child, S.TaphColor, "TRAP")
		elseif S.AzureEsp and (n:find("azure") or n:find("plant") or n:find("flower") or n:find("bloom")) and (child:IsA("Model") or child:IsA("BasePart")) then
			applyHL(child, S.AzureColor, "AZURE")
		end
	end
end

