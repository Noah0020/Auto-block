local function isFacingUs(kRoot, ourRoot)
	local toUs = ourRoot.Position - kRoot.Position
	if toUs.Magnitude < 0.05 then return true end
	return kRoot.CFrame.LookVector:Dot(toUs.Unit) >= S.FacingThreshold
end

local function faceKiller(kRoot)
	if not S.FaceKillerOnBlock then return end
	local our = getRoot(LocalPlayer.Character)
	if not our or not kRoot then return end
	local flat = Vector3.new(kRoot.Position.X, our.Position.Y, kRoot.Position.Z)
	if (flat - our.Position).Magnitude > 0.1 then
		our.CFrame = CFrame.lookAt(our.Position, flat)
	end
end

local function onBlockSound(sound, kRoot)
	if not S.AutoBlock then return end
	if sound and sound:IsA("Sound") and blockSounds[sound.SoundId] then
		faceKiller(kRoot)
		fireAbility("Block")
		setHDTVisual(true)
		task.delay(0.4, function() setHDTVisual(false) end)
	end
end

local function trackKillerBlock(model)
	if blockTracked[model] then return end
	local hrp = getRoot(model)
	if not hrp then return end
	local conns = {}
	local listening = false

	local function stopListen()
		for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
		table.clear(conns)
		listening = false
	end

	local function startListen()
		if listening then return end
		listening = true
		table.insert(conns, model.DescendantAdded:Connect(function(d)
			if d:IsA("Sound") then
				onBlockSound(d, hrp)
				table.insert(conns, d.Played:Connect(function() onBlockSound(d, hrp) end))
			end
		end))
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("Sound") then
				table.insert(conns, d.Played:Connect(function() onBlockSound(d, hrp) end))
				if d.IsPlaying then onBlockSound(d, hrp) end
			end
		end
	end

	local hb
	hb = RunService.Heartbeat:Connect(function()
		if not S.AutoBlock then
			stopListen(); if hb then hb:Disconnect() end; blockTracked[model] = nil; return
		end
		if not model.Parent or not hrp.Parent then
			stopListen(); if hb then hb:Disconnect() end; blockTracked[model] = nil; return
		end
		local our = getRoot(LocalPlayer.Character)
		if not our then return end
		local dist = (our.Position - hrp.Position).Magnitude
		local facing = isFacingUs(hrp, our)
		if dist <= S.BlockRange and facing then
			startListen()
			if S.VisualHDT then setHDTVisual(true) end
			if S.FaceKillerOnBlock then faceKiller(hrp) end
		else
			stopListen()
			setHDTVisual(false)
		end
	end)
	blockTracked[model] = function()
		stopListen()
		if hb then hb:Disconnect() end
		blockTracked[model] = nil
	end
end

local function setAutoBlock(on)
	S.AutoBlock = on
	if on then
		for _, k in ipairs(getKillers()) do trackKillerBlock(k) end
		local folder = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
		if folder and not blockChildConn then
			blockChildConn = folder.ChildAdded:Connect(function(c) task.defer(trackKillerBlock, c) end)
		end
	else
		if blockChildConn then blockChildConn:Disconnect() blockChildConn = nil end
		for _, cleanup in pairs(blockTracked) do cleanup() end
		table.clear(blockTracked)
		setHDTVisual(false)
	end
end

