local function isFacingUs(killerRoot, ourRoot)
	local toUs = ourRoot.Position - killerRoot.Position
	if toUs.Magnitude < 0.05 then return true end
	return killerRoot.CFrame.LookVector:Dot(toUs.Unit) >= State.FacingThreshold
end

local function onBlockSound(sound)
	if not State.AutoBlock then return end
	if sound and sound:IsA("Sound") and blockSounds[sound.SoundId] then
		fireAbility("Block")
	end
end

local function trackKillerBlock(model)
	if blockTracked[model] then return end
	local hrp = getRoot(model)
	if not hrp then return end
	local conns = {}
	local listening = false

	local function stopListen()
		for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
		table.clear(conns)
		listening = false
	end

	local function startListen()
		if listening then return end
		listening = true
		table.insert(conns, model.DescendantAdded:Connect(function(d)
			if d:IsA("Sound") then
				onBlockSound(d)
				table.insert(conns, d.Played:Connect(function() onBlockSound(d) end))
			end
		end))
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("Sound") then
				table.insert(conns, d.Played:Connect(function() onBlockSound(d) end))
				if d.IsPlaying then onBlockSound(d) end
			end
		end
	end

	local hb
	hb = RunService.Heartbeat:Connect(function()
		if not State.AutoBlock then
			stopListen()
			if hb then hb:Disconnect() end
			blockTracked[model] = nil
			return
		end
		if not model.Parent or not hrp.Parent then
			stopListen()
			if hb then hb:Disconnect() end
			blockTracked[model] = nil
			return
		end
		local our = getRoot(LocalPlayer.Character)
		if not our then return end
		local dist = (our.Position - hrp.Position).Magnitude
		if dist <= State.BlockRange and isFacingUs(hrp, our) then
			startListen()
		else
			stopListen()
		end
	end)
	blockTracked[model] = function()
		stopListen()
		if hb then hb:Disconnect() end
		blockTracked[model] = nil
	end
end

local function setAutoBlock(on)
	State.AutoBlock = on
	if on then
		for _, k in ipairs(getKillers()) do trackKillerBlock(k) end
		local folder = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
		if folder and not blockChildConn then
			blockChildConn = folder.ChildAdded:Connect(function(c) task.defer(trackKillerBlock, c) end)
		end
	else
		if blockChildConn then blockChildConn:Disconnect() blockChildConn = nil end
		for _, cleanup in pairs(blockTracked) do cleanup() end
		table.clear(blockTracked)
	end
end

-- NOCLIP / INVIS
local function setNoclip(on)
	State.Noclip = on
	if noclipConn then noclipConn:Disconnect() noclipConn = nil end
	if not on then
		local char = LocalPlayer.Character
		if char then
			for _, n in ipairs({"Torso","HumanoidRootPart","Head","CollisionHitbox","UpperTorso","LowerTorso"}) do
				local p = char:FindFirstChild(n)
				if p and p:IsA("BasePart") then p.CanCollide = true end
			end
		end
		return
	end
	noclipConn = RunService.Stepped:Connect(function()
		if not State.Noclip then return end
		local char = LocalPlayer.Character
		if not char then return end
		for _, n in ipairs({"Torso","HumanoidRootPart","Head","CollisionHitbox","UpperTorso","LowerTorso"}) do
			local p = char:FindFirstChild(n)
			if p and p:IsA("BasePart") then p.CanCollide = false end
		end
	end)
end

local function setInvis(on)
	State.Invis = on
	local char = LocalPlayer.Character
	if not char then return end
	for _, n in ipairs({"Torso","UpperTorso","LowerTorso","HumanoidRootPart","Head"}) do
		local p = char:FindFirstChild(n)
		if p and p:IsA("BasePart") then p.CanCollide = not on end
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if on and animator then
		if invisTrack then pcall(function() invisTrack:Stop() end) end
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://75804462760596"
		invisTrack = animator:LoadAnimation(anim)
		invisTrack:Play()
		invisTrack:AdjustSpeed(0)
	elseif invisTrack then
		pcall(function() invisTrack:Stop() end)
		invisTrack = nil
	end
end

-- M1 BRIEF LOCK
local function m1Step()
	if not State.M1Lock then return end
	local now = os.clock()
	local our = getRoot(LocalPlayer.Character)
	if not our then return end
	if now < m1LockUntil and m1Target and m1Target.Parent then
		local flat = Vector3.new(m1Target.Position.X, our.Position.Y, m1Target.Position.Z)
		if (flat - our.Position).Magnitude > 0.15 then
			our.CFrame = CFrame.lookAt(our.Position, flat)
		end
		return
	end
	for _, k in ipairs(getKillers()) do
		local hrp = getRoot(k)
		local hum = k:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then continue end
		if (hrp.Position - our.Position).Magnitude > State.M1LockRange then continue end
		local anim = hum:FindFirstChildOfClass("Animator")
		if not anim then continue end
		for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
			local id = track.Animation and tostring(track.Animation.AnimationId) or ""
			if id ~= "" and track.Length > 0 and track.TimePosition / track.Length < 0.55 then
				if id:find("Slash") or id:find("Attack") or id:find("Punch") or id:find("Stab") or id:find("Swing") or blockSounds[id] then
					m1Target = hrp
					m1LockUntil = now + State.M1LockDur
					return
				end
			end
		end
	end
end

-- TWO TIME
local function ttStep()
	if not State.TwoTimeBackstab then return end
	local char = LocalPlayer.Character
	if not char or char.Name ~= "TwoTime" then return end
	local root = getRoot(char)
	if not root then return end
	local target, bestD = nil, State.TwoTimeDist
	for _, k in ipairs(getKillers()) do
		local hrp = getRoot(k)
		local hum = k:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 then
			local d = (hrp.Position - root.Position).Magnitude
			if d < bestD then bestD, target = d, k end
		end
	end
	if not target then return end
	local tRoot = getRoot(target)
	if not tRoot then return end
	if os.clock() - ttLast < 1.15 then return end
	ttLast = os.clock()
	local behind = tRoot.CFrame * CFrame.new(0, 0, 3)
	if State.TwoTimeType == "Teleport" then
		root.CFrame = behind
	else
		root.CFrame = root.CFrame:Lerp(behind, 0.35)
	end
	fireAbility("Dagger")
end

-- SILENT AIM
local function installSilent()
	if silentInstalled then return end
	local ok, mod = pcall(function()
		return require(ReplicatedStorage.Systems.Player.Miscellaneous.GetPlayerMousePosition)
	end)
	if not (ok and mod and type(mod.GetMousePos) == "function") then return end
	local old = mod.GetMousePos
	if type(hookfunction) ~= "function" then return end
	hookfunction(old, function(...)
		if State.SilentAim then
			local target = closestEnemyRoot(150)
			if target then
				local vel = target.AssemblyLinearVelocity or Vector3.zero
				return target.Position + vel * State.SilentLead
			end
		end
		return old(...)
	end)
	silentInstalled = true
end

