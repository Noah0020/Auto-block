local function fireAbility(name)
	if not remoteEvent then return end
	pcall(function()
		local packed = buffer.fromstring(string.pack("<Bi4", 3, #name) .. name)
		remoteEvent:FireServer("UseActorAbility", { packed })
	end)
end

local function getRole()
	local char = LocalPlayer.Character
	local parent = char and char.Parent
	if not parent then return "None" end
	local n = parent.Name
	if n == "Killers" or n == "Survivors" then return n end
	return "None"
end

local function getKillers()
	local folder = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
	if not folder then return {} end
	local t = {}
	for _, c in ipairs(folder:GetChildren()) do
		if c:IsA("Model") then table.insert(t, c) end
	end
	return t
end

local function getSurvivors()
	local folder = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Survivors")
	if not folder then return {} end
	local t = {}
	for _, c in ipairs(folder:GetChildren()) do
		if c:IsA("Model") then table.insert(t, c) end
	end
	return t
end

local function getRoot(model)
	return model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart)
end

local function closestEnemyRoot(maxDist)
	local our = getRoot(LocalPlayer.Character)
	if not our then return nil end
	local role = getRole()
	local list = (role == "Survivors") and getKillers() or getSurvivors()
	local best, bestD = nil, maxDist or 200
	for _, m in ipairs(list) do
		if m ~= LocalPlayer.Character then
			local hrp = getRoot(m)
			local hum = m:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local d = (hrp.Position - our.Position).Magnitude
				if d < bestD then bestD, best = d, hrp end
			end
		end
	end
	return best, bestD
end

-- ESP
local function clearHighlight(model)
	if highlights[model] then
		pcall(function() highlights[model]:Destroy() end)
		highlights[model] = nil
	end
end

local function applyHighlight(model, color)
	if not model or not model.Parent then return end
	local h = highlights[model]
	if not h or not h.Parent then
		h = Instance.new("Highlight")
		h.Name = "HS_HL"
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.FillTransparency = 0.65
		h.OutlineTransparency = 0
		h.Parent = model
		highlights[model] = h
	end
	h.FillColor = color
	h.OutlineColor = color
	h.Adornee = model
end

local function refreshEsp()
	for model in pairs(highlights) do
		if not model.Parent then clearHighlight(model) end
	end
	if State.KillerEsp then
		for _, k in ipairs(getKillers()) do applyHighlight(k, State.EspKillerColor) end
	else
		for _, k in ipairs(getKillers()) do clearHighlight(k) end
	end
	if State.SurvivorEsp then
		for _, s in ipairs(getSurvivors()) do
			if s ~= LocalPlayer.Character then applyHighlight(s, State.EspSurvivorColor) end
		end
	else
		for _, s in ipairs(getSurvivors()) do clearHighlight(s) end
	end
end

task.spawn(function()
	while true do
		task.wait(1.2)
		if State.KillerEsp or State.SurvivorEsp then pcall(refreshEsp) end
	end
end)

