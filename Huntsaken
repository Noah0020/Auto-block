-- ===================== HELPERS =====================
local function getRoot(model)
	return model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart)
end

local function getRole()
	local char = LocalPlayer.Character
	local p = char and char.Parent
	if not p then return "None" end
	if p.Name == "Killers" or p.Name == "Survivors" then return p.Name end
	return "None"
end

local function getKillers()
	local f = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
	if not f then return {} end
	local t = {}
	for _, c in ipairs(f:GetChildren()) do
		if c:IsA("Model") then table.insert(t, c) end
	end
	return t
end

local function getSurvivors()
	local f = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Survivors")
	if not f then return {} end
	local t = {}
	for _, c in ipairs(f:GetChildren()) do
		if c:IsA("Model") then table.insert(t, c) end
	end
	return t
end

local function closestFrom(list, maxDist, origin)
	local best, bestD = nil, maxDist or 200
	for _, m in ipairs(list) do
		if m ~= LocalPlayer.Character then
			local hrp = getRoot(m)
			local hum = m:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local d = (hrp.Position - origin).Magnitude
				if d < bestD then bestD, best = d, hrp end
			end
		end
	end
	return best, bestD
end

local function closestEnemy(maxDist)
	local our = getRoot(LocalPlayer.Character)
	if not our then return nil end
	local role = getRole()
	local list = (role == "Survivors") and getKillers() or getSurvivors()
	return closestFrom(list, maxDist, our.Position)
end

