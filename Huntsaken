local function rushStep()
	local char = LocalPlayer.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = getRoot(char)
	if not hum or not hrp then return end
	local name = char.Name
	local camLook = Camera.CFrame.LookVector
	local dir = Vector3.new(camLook.X, 0, camLook.Z)
	if dir.Magnitude < 0.05 then return end
	dir = dir.Unit

	-- Noli Void Rush
	if S.NoliRush and name == "Noli" then
		local state = char:GetAttribute("VoidRushState")
		if state == "Charging" or state == "Dashing" then
			hum.AutoRotate = false
			hum.WalkSpeed = S.NoliRushSpeed
			local vel = Vector3.new(dir.X * S.NoliRushSpeed, hrp.AssemblyLinearVelocity.Y, dir.Z * S.NoliRushSpeed)
			hrp.AssemblyLinearVelocity = vel
			hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + dir)
			hum:Move(dir)
			for _, c in ipairs(hrp:GetChildren()) do
				if c:IsA("BodyVelocity") then c.Velocity = vel
				elseif c:IsA("LinearVelocity") then c.VectorVelocity = vel end
			end
		end
	end

	-- c00lkidd void / dash control
	if S.CoolkiddRush and (name == "c00lkidd" or name == "Coolkidd" or name:lower():find("c00l")) then
		local anim = hum:FindFirstChildOfClass("Animator")
		local dashing = false
		if anim then
			for _, tr in ipairs(anim:GetPlayingAnimationTracks()) do
				local id = tr.Animation and tostring(tr.Animation.AnimationId) or ""
				if id:find("Dash") or id:find("Rush") or id:find("Void") or id:find("Charge") then
					dashing = true
					break
				end
			end
		end
		local st = char:GetAttribute("VoidRushState") or char:GetAttribute("DashState")
		if dashing or st == "Dashing" or st == "Charging" then
			hum.AutoRotate = false
			local spd = S.CoolkiddRushSpeed
			local vel = Vector3.new(dir.X * spd, hrp.AssemblyLinearVelocity.Y, dir.Z * spd)
			hrp.AssemblyLinearVelocity = vel
			hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + dir)
			hum:Move(dir)
		end
	end
end

local function installAntiCrash()
	if antiCrashHooked then return end
	antiCrashHooked = true
	-- Block known crash remotes
	local mt = getrawmetatable and getrawmetatable(game)
	if mt and setreadonly then
		pcall(function()
			setreadonly(mt, false)
			local old = mt.__namecall
			mt.__namecall = newcclosure(function(self, ...)
				local method = getnamecallmethod()
				local args = {...}
				if method == "FireServer" and typeof(args[1]) == "string" then
					if string.find(args[1], "C00lkiddCollision") or string.find(args[1], "NoliCrash") or string.find(args[1], "VoidCrash") then
						return
					end
				end
				return old(self, ...)
			end)
			setreadonly(mt, true)
		end)
	end
	-- Velocity clamp to prevent physics crash
	RunService.Heartbeat:Connect(function()
		if not S.AntiCrash then return end
		local hrp = getRoot(LocalPlayer.Character)
		if not hrp then return end
		local v = hrp.AssemblyLinearVelocity
		if v.Magnitude > 250 then
			hrp.AssemblyLinearVelocity = v.Unit * 250
		end
		if math.abs(hrp.Position.Y) > 5000 then
			local char = LocalPlayer.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then hum.Health = 0 end
		end
	end)
end

local function farmStep()
	if not S.AutoFarm then return end
	local hrp = getRoot(LocalPlayer.Character)
	if not hrp then return end
	if S.FarmMode == "Generators" then
		local map = scanMapObjects()
		if not map then return end
		local best, bestD = nil, 999
		for _, child in ipairs(map:GetChildren()) do
			if child.Name == "Generator" or child.Name == "FakeGenerator" then
				local progress = child:FindFirstChild("Progress")
				local main = child:FindFirstChild("Main")
				if main and progress and progress.Value < 100 then
					local d = (main.Position - hrp.Position).Magnitude
					if d < bestD then bestD, best = d, main end
				end
			end
		end
		if best then
			hrp.CFrame = CFrame.new(best.Position + Vector3.new(0, 3, 0))
		end
	elseif S.FarmMode == "Kill Survivors" then
		local target = closestFrom(getSurvivors(), 500, hrp.Position)
		if target then
			hrp.CFrame = CFrame.new(target.Position + Vector3.new(0, 2, 3))
		end
	end
end


