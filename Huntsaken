local function punchStep()
	if not S.AutoPunch then return end
	if os.clock() - punchLast < S.PunchCD then return end
	local char = LocalPlayer.Character
	if not char then return end
	local name = char.Name
	if name ~= "Guest1337" and name ~= "Guest" then return end
	local our = getRoot(char)
	if not our then return end
	local target = closestFrom(getKillers(), 12, our.Position)
	if target then
		punchLast = os.clock()
		faceKiller(target)
		fireAbility("Punch")
	end
end

-- ===================== REACH =====================
local origSizes = {}
local function setReach(on)
	S.Reach = on
	if reachConn then reachConn:Disconnect() reachConn = nil end
	if not on then
		for part, sz in pairs(origSizes) do
			if part and part.Parent then pcall(function() part.Size = sz end) end
		end
		table.clear(origSizes)
		return
	end
	reachConn = RunService.Heartbeat:Connect(function()
		if not S.Reach then return end
		local char = LocalPlayer.Character
		if not char then return end
		for _, n in ipairs({"RightHand","LeftHand","Right Arm","Left Arm","RightLowerArm","LeftLowerArm","Handle"}) do
			local p = char:FindFirstChild(n, true)
			if p and p:IsA("BasePart") then
				if not origSizes[p] then origSizes[p] = p.Size end
				local s = S.ReachSize
				p.Size = Vector3.new(s, s, s)
				p.Massless = true
				p.CanCollide = false
			end
		end
		-- tool handle
		for _, t in ipairs(char:GetChildren()) do
			if t:IsA("Tool") then
				local h = t:FindFirstChild("Handle")
				if h and h:IsA("BasePart") then
					if not origSizes[h] then origSizes[h] = h.Size end
					h.Size = Vector3.new(S.ReachSize, S.ReachSize, S.ReachSize)
					h.Massless = true
					h.CanCollide = false
				end
			end
		end
	end)
end

-- ===================== HITBOX DRAG =====================
local function dragStep()
	if not S.HitboxDrag then return end
	local our = getRoot(LocalPlayer.Character)
	if not our then return end
	local target = closestEnemy(S.DragRange)
	if not target then return end
	local dir = (target.Position - our.Position)
	if dir.Magnitude < 0.5 then return end
	-- only drag during our attack anim
	local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	local anim = hum and hum:FindFirstChildOfClass("Animator")
	local swinging = false
	if anim then
		for _, tr in ipairs(anim:GetPlayingAnimationTracks()) do
			local id = tr.Animation and tostring(tr.Animation.AnimationId) or ""
			if id ~= "" and tr.Length > 0 and tr.TimePosition / tr.Length < 0.7 then
				if id:find("Slash") or id:find("Attack") or id:find("Punch") or id:find("Stab") or id:find("Swing") or id:find("Hit") then
					swinging = true
					break
				end
			end
		end
	end
	if swinging then
		our.AssemblyLinearVelocity = dir.Unit * S.DragSpeed + Vector3.new(0, our.AssemblyLinearVelocity.Y, 0)
	end
end

-- ===================== AIM / SILENT / M1 LOCK =====================
local function installSilent()
	if silentInstalled then return end
	local ok, mod = pcall(function()
		return require(ReplicatedStorage.Systems.Player.Miscellaneous.GetPlayerMousePosition)
	end)
	if not (ok and mod and type(mod.GetMousePos) == "function") then return end
	local old = mod.GetMousePos
	if type(hookfunction) ~= "function" then return end
	hookfunction(old, function(...)
		if S.SilentAim or S.SurvAim or S.KillerAim then
			local target = closestEnemy(S.AimDist)
			if target then
				local vel = target.AssemblyLinearVelocity or Vector3.zero
				local lead = (S.SurvAim and S.SurvPredict) or S.SilentLead
				return target.Position + vel * lead
			end
		end
		return old(...)
	end)
	silentInstalled = true
end

local function aimStep()
	if not (S.SurvAim or S.KillerAim) then return end
	local our = getRoot(LocalPlayer.Character)
	if not our then return end
	local role = getRole()
	local list
	if S.KillerAim and role == "Killers" then
		list = getSurvivors()
	elseif S.SurvAim and role == "Survivors" then
		list = getKillers()
	else
		return
	end
	local target = closestFrom(list, S.AimDist, our.Position)
	if not target then return end
	local pred = target.Position + (target.AssemblyLinearVelocity or Vector3.zero) * S.SurvPredict
	local flat = Vector3.new(pred.X, our.Position.Y, pred.Z)
	local goal = CFrame.lookAt(our.Position, flat)
	our.CFrame = our.CFrame:Lerp(goal, S.AimSmooth)
end

local function m1Step()
	if not S.M1Lock then return end
	local now = os.clock()
	local our = getRoot(LocalPlayer.Character)
	if not our then return end
	if now < m1LockUntil and m1Target and m1Target.Parent then
		local flat = Vector3.new(m1Target.Position.X, our.Position.Y, m1Target.Position.Z)
		if (flat - our.Position).Magnitude > 0.15 then
			our.CFrame = CFrame.lookAt(our.Position, flat)
		end
		return
	end
	for _, k in ipairs(getKillers()) do
		local hrp = getRoot(k)
		local hum = k:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then continue end
		if (hrp.Position - our.Position).Magnitude > S.M1LockRange then continue end
		local anim = hum:FindFirstChildOfClass("Animator")
		if not anim then continue end
		for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
			local id = track.Animation and tostring(track.Animation.AnimationId) or ""
			if id ~= "" and track.Length > 0 and track.TimePosition / track.Length < 0.55 then
				if id:find("Slash") or id:find("Attack") or id:find("Punch") or id:find("Stab") or id:find("Swing") or blockSounds[id] then
					m1Target = hrp
					m1LockUntil = now + S.M1LockDur
					return
				end
			end
		end
	end
end

-- ===================== STAMINA =====================
local function applyStamina()
	local ok, Sprinting = pcall(function()
		return require(ReplicatedStorage.Systems.Character.Game.Sprinting)
	end)
	if not ok or not Sprinting then return end
	if S.InfStam then
		pcall(function()
			Sprinting.StaminaLossDisabled = true
			if Sprinting.Stamina and Sprinting.MaxStamina then
				Sprinting.Stamina = Sprinting.MaxStamina
			end
		end)
	end
	if S.CustomStam then
		pcall(function()
			Sprinting.MaxStamina = S.MaxStam
