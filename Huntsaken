local function genLoop()
	while genFlag do
		local cd = S.GenCD
		local start = os.clock()
		while genFlag and os.clock() - start < cd do
			RunService.Heartbeat:Wait()
		end
		if not genFlag then break end
		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local map = scanMapObjects()
		if hrp and map then
			for _, child in ipairs(map:GetChildren()) do
				if child.Name == "Generator" or child.Name == "FakeGenerator" then
					local progress = child:FindFirstChild("Progress")
					if progress and progress.Value ~= 100 then
						local main = child:FindFirstChild("Main")
						if main and (hrp.Position - main.Position).Magnitude < 12 then
							local remotes = child:FindFirstChild("Remotes")
							local re = remotes and remotes:FindFirstChild("RE")
							if re then pcall(function() re:FireServer() end) end
						end
					end
				end
			end
		end
	end
end

local function setAutoGen(on)
	S.AutoGen = on
	if genThread then task.cancel(genThread) genThread = nil end
	genFlag = false
	if not on then return end
	local pg = LocalPlayer:FindFirstChild("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
	if not pg then return end
	local function start()
		genFlag = true
		if genThread then task.cancel(genThread) end
		genThread = task.spawn(genLoop)
	end
	local function stop()
		genFlag = false
		if genThread then task.cancel(genThread) genThread = nil end
	end
	if genConn then genConn:Disconnect() end
	genConn = pg.ChildAdded:Connect(function(c)
		if c.Name == "PuzzleUI" then start() end
	end)
	pg.ChildRemoved:Connect(function(c)
		if c.Name == "PuzzleUI" then stop() end
	end)
	if pg:FindFirstChild("PuzzleUI") then start() end
end

