task.spawn(function()
	pcall(function()
		local function getKillerFolder()
			local p = Workspace:FindFirstChild("Players")
			return p and p:FindFirstChild("Killers")
		end

		local function getKHRP(m)
			if not m then return nil end
			return m:FindFirstChild("HumanoidRootPart")
				or m.PrimaryPart
				or m:FindFirstChildWhichIsA("BasePart", true)
		end

		local function getMyHRP()
			local c = LocalPlayer.Character
			return c and c:FindFirstChild("HumanoidRootPart")
		end

		local function getMyHum()
			local c = LocalPlayer.Character
			return c and c:FindFirstChildOfClass("Humanoid")
		end

		local function getKiller()
			local f = getKillerFolder()
			if not f then return nil, nil end
			for _, k in ipairs(f:GetChildren()) do
				if k:IsA("Model") then
					local h = getKHRP(k)
					local hum = k:FindFirstChildOfClass("Humanoid")
					if h and hum and hum.Health > 0 then return k, h end
				end
			end
			return nil, nil
		end

		local function isDagger(track)
			local a = track and track.Animation
			if not a then return false end
			local n = tostring(a.AnimationId):match("%d+")
			return n and DAGGER_ANIM_IDS[n] == true
		end

		local function stopLerp()
			if lerpConn then
				pcall(function() lerpConn:Disconnect() end)
				lerpConn = nil
			end
			local hum = getMyHum()
			if hum then hum.AutoRotate = originalAutoRotate end
			stabbing = false
		end

		local function followBehind(killerModel)
			if lerpConn then
				pcall(function() lerpConn:Disconnect() end)
				lerpConn = nil
			end

			local myHum = getMyHum()
			originalAutoRotate = myHum and myHum.AutoRotate or true
			if myHum then myHum.AutoRotate = false end

			local endTime = os.clock() + CFG.FollowDuration

			lerpConn = RunService.RenderStepped:Connect(function()
				if os.clock() >= endTime or not stabbing then
					stopLerp()
					return
				end

				local h = getMyHRP()
				if not h then
					stopLerp()
					return
				end

				local kHRP = killerModel and getKHRP(killerModel)
				if not kHRP or not kHRP.Parent then
					stopLerp()
					return
				end

				local kCF = kHRP.CFrame
				local behindPos = kCF.Position - kCF.LookVector * CFG.BehindOffset
				local targetCF = CFrame.lookAt(
					Vector3.new(behindPos.X, h.Position.Y, behindPos.Z),
					Vector3.new(kCF.Position.X, h.Position.Y, kCF.Position.Z)
				)

				h.CFrame = h.CFrame:Lerp(targetCF, 0.5)
				h.AssemblyLinearVelocity = Vector3.zero
			end)
		end

		local function hunterstab()
			if not CFG.Enabled then return end
			if stabbing then return end
			if os.clock() - lastStab < CFG.Cooldown then return end

			local myHRP = getMyHRP()
			if not myHRP then return end

			local killer, kHRP = getKiller()
			if not killer or not kHRP then return end

			local dist = (kHRP.Position - myHRP.Position).Magnitude
			if dist > CFG.MaxRange then return end

			stabbing = true
			lastStab = os.clock()

			local kCF = kHRP.CFrame
			local behindPos = kCF.Position - kCF.LookVector * CFG.BehindOffset
			local origin = myHRP.CFrame
			local behind = CFrame.lookAt(
				Vector3.new(behindPos.X, origin.Position.Y, behindPos.Z),
				Vector3.new(kCF.Position.X, origin.Position.Y, kCF.Position.Z)
			)

			task.wait(CFG.TeleportDelay)

			local now = getMyHRP()
			if not now then stabbing = false return end
			now.CFrame = behind
			now.AssemblyLinearVelocity = Vector3.zero

			followBehind(killer)
		end

		_G.HunterStab = hunterstab

		local hookedAnim = setmetatable({}, {__mode = "k"})
		local function hookAnim(anim)
			if not anim or not anim:IsA("Animator") or hookedAnim[anim] then return end
			hookedAnim[anim] = true

			anim.AnimationPlayed:Connect(function(t)
				if not t or not isDagger(t) then return end
				hunterstab()
			end)
		end

		local function bind(char)
			if not char then return end
			local h = char:FindFirstChildOfClass("Humanoid")
			if not h then return end
			local a = h:FindFirstChildOfClass("Animator") or h:WaitForChild("Animator", 3)
			if a then hookAnim(a) end
			char.DescendantAdded:Connect(function(d)
				if d:IsA("Animator") then hookAnim(d) end
			end)
		end

		if LocalPlayer.Character then bind(LocalPlayer.Character) end
		LocalPlayer.CharacterAdded:Connect(function(c)
			stopLerp()
			bind(c)
		end)

		UserInputService.InputBegan:Connect(function(input, processed)
			if processed then return end
			if input.KeyCode == Enum.KeyCode.H then
				hunterstab()
			end
		end)

		print("[HS] Logic loaded")
	end)
end)

