rebuildViewer = function()
    for _, c in ipairs(viewerList:GetChildren()) do
        if not c:IsA("UIListLayout") then
            c:Destroy()
        end
    end

    local charKeys = {}
    for k, _ in pairs(S.Learned) do
        table.insert(charKeys, k)
    end
    table.sort(charKeys)

    if viewerState.selectedChar and not S.Learned[viewerState.selectedChar] then
        viewerState.selectedChar = nil
        viewerBtn.Text = "All"
    end

    local toShow = viewerState.selectedChar and {viewerState.selectedChar} or charKeys

    if #toShow == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, 0, 0, 24)
        empty.BackgroundTransparency = 1
        empty.Text = "No learned anims yet."
        empty.TextColor3 = TEXT_DIM
        empty.Font = Enum.Font.Gotham
        empty.TextSize = 11
        empty.TextXAlignment = Enum.TextXAlignment.Left
        empty.Parent = viewerList
        return
    end

    for _, charKey in ipairs(toShow) do
        local anims = S.Learned[charKey] or {}
        local animIds = {}
        for id, _ in pairs(anims) do
            table.insert(animIds, id)
        end
        table.sort(animIds)

        makeCharHeader(charKey, #animIds)

        for _, id in ipairs(animIds) do
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 26)
            row.BackgroundColor3 = Color3.fromRGB(28, 22, 24)
            row.BorderSizePixel = 0
            row.Parent = viewerList
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 5)

            local idLbl = Instance.new("TextLabel")
            idLbl.Size = UDim2.new(1, -50, 1, 0)
            idLbl.Position = UDim2.fromOffset(10, 0)
            idLbl.BackgroundTransparency = 1
            idLbl.Text = "ID: " .. tostring(id)
            idLbl.TextColor3 = TEXT_MAIN
            idLbl.Font = Enum.Font.Code
            idLbl.TextSize = 11
            idLbl.TextXAlignment = Enum.TextXAlignment.Left
            idLbl.Parent = row

            local del = Instance.new("TextButton")
            del.Size = UDim2.fromOffset(22, 18)
            del.Position = UDim2.new(1, -28, 0.5, -9)
            del.BackgroundColor3 = ACCENT_DIM
            del.Text = "×"
            del.TextColor3 = Color3.new(1, 1, 1)
            del.Font = Enum.Font.GothamBold
            del.TextSize = 12
            del.AutoButtonColor = false
            del.Parent = row
            Instance.new("UICorner", del).CornerRadius = UDim.new(0, 4)

            del.MouseEnter:Connect(function() del.BackgroundColor3 = ACCENT end)
            del.MouseLeave:Connect(function() del.BackgroundColor3 = ACCENT_DIM end)
            del.MouseButton1Click:Connect(function()
                deleteLearned(charKey, id)
                rebuildViewer()
                notify("HunterAim", "Removed " .. id, 2)
            end)
        end
    end
end

viewerBtn.MouseButton1Click:Connect(function()
    local keys = {"__ALL__"}
    local list = {}
    for k, _ in pairs(S.Learned) do
        table.insert(list, k)
    end
    table.sort(list)
    for _, k in ipairs(list) do
        table.insert(keys, k)
    end

    local cur = viewerState.selectedChar or "__ALL__"
    local idx = 1
    for i, k in ipairs(keys) do
        if k == cur then idx = i break end
    end
    idx = idx + 1
    if idx > #keys then idx = 1 end

    local nextKey = keys[idx]
    if nextKey == "__ALL__" then
        viewerState.selectedChar = nil
        viewerBtn.Text = "All"
    else
        viewerState.selectedChar = nextKey
        viewerBtn.Text = nextKey
    end
